# Copy to .env and fill in. Never commit real private keys.
# These are PUBLIC (publishable) values, safe to expose in the browser bundle.
VITE_SUPABASE_URL=your_supabase_project_url_here
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here
VITE_SUPABASE_PROJECT_ID=your_supabase_project_id_here

# Server-side mirrors of the same public values (used during SSR)
SUPABASE_URL=your_supabase_project_url_here
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here
SUPABASE_PROJECT_ID=your_supabase_project_id_here

# PRIVATE - never commit. Injected by the hosting platform at runtime.
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
# LOVABLE_CRON_SECRET=your_cron_secret_here
